{
  "name": "banwao-marketplace",
  "version": "1.0.0",
  "description": "Banwao - Home Construction & Services Marketplace for Noida & Greater Noida",
  "private": true,
  "scripts": {
    "setup": "npm run setup:server && npm run setup:client",
    "setup:server": "cd server && npm install",
    "setup:client": "cd client && npm install",
    "predev": "npx kill-port 5000 5173",
    "dev": "concurrently --kill-others \"npm run dev:server\" \"npm run dev:client\"",
    "start": "concurrently --kill-others \"npm run start:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start:server": "cd server && npm start",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "create-admin": "cd server && npm run create-admin",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "kill-port": "^2.0.1"
  }
}
