# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/banwao_db

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_banwao_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_banwao_2026

# Optional Admin Initialization Credentials
ADMIN_NAME=Banwao Super Admin
ADMIN_EMAIL=admin@banwao.in
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_PHONE=+919876543210

# Optional SMTP Email Service Setup
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@banwao.in
FROM_NAME=Banwao Marketplace

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
